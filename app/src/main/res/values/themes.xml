<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Jojos_Cup_Of_Jo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/coffee_mocha_700</item>
        <item name="colorOnPrimary">@color/coffee_cream_50</item>
        <item name="colorPrimaryContainer">@color/coffee_cream_200</item>
        <item name="colorOnPrimaryContainer">@color/coffee_espresso_900</item>
        <item name="colorSecondary">@color/sunflower_yellow_500</item>
        <item name="colorOnSecondary">@color/coffee_espresso_900</item>
        <item name="colorSurface">@color/coffee_cream_50</item>
        <item name="colorOnSurface">@color/coffee_espresso_900</item>
        <item name="android:colorBackground">@color/coffee_cream_100</item>
    </style>

    <style name="Theme.Jojos_Cup_Of_Jo" parent="Base.Theme.Jojos_Cup_Of_Jo" />

    <style name="TextAppearance.Jojo.SectionHeading" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Jojo.Quote" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textStyle">italic</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.Jojo.Body" parent="TextAppearance.Material3.BodyMedium" />
</resources>
